   "type": "text",
   "text": "Summary, compare,\nhistory by item,\ndownload",
   "x": 4480.0,
   "y": 11800.0,
   "width": 300,
   "height": 70,
   "color": "5"
  },
  {
   "id": "n386",
   "type": "text",
   "text": "**All roles:** Calendar \u2014\nread-only, role-scoped,\n60s cache, aggregates events\nfrom other modules",
