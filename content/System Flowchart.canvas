   "y": 11410.0,
   "width": 280,
   "height": 65,
   "color": "3"
  },
  {
   "id": "n366",
   "type": "text",
   "text": "**Architect/Consultant/\nOwner:** Read-only view",
   "x": 3250.0,
   "y": 11605.0,
   "width": 280,
   "height": 60
  },
  {
   "id": "n367",
   "type": "text",
