   "width": 1260,
   "height": 300,
   "color": "6"
  },
  {
   "id": "n392",
   "type": "text",
   "text": "**Any role except\nIT Designer:** File account\nsupport request\n(password reset, email\nchange, role access,\ncannot sign in, other)",
